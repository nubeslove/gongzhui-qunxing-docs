[Unit]
Description=Gongzhui Qunxing account, signaling and resource service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gongzhui
Group=gongzhui
WorkingDirectory=/srv/gongzhui/current/game/apps/server
EnvironmentFile=/etc/gongzhui/server.env
ExecStart=/usr/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gongzhui

[Install]
WantedBy=multi-user.target
