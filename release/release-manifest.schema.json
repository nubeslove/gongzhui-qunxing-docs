{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共坠群星发行清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "releaseId", "status", "appVersion", "serverVersion", "docsSnapshot", "compatibility", "artifacts"],
  "properties": {
    "format": {"const":"gongzhui-release"},
    "version": {"const":1},
    "releaseId": {"type":"string","minLength":1},
    "status": {"enum":["draft","published","withdrawn"]},
    "appVersion": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "serverVersion": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "docsSnapshot": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceRevision": {"type":"string","minLength":1},
    "sourceSnapshotSha256": {"$ref":"#/$defs/sha256"},
    "lockfileSha256": {"$ref":"#/$defs/sha256"},
    "notes": {"type":"string"},
    "compatibility": {
      "type":"object", "additionalProperties":false,
      "required":["clientServerPairTested","requiredServerCapabilities","systems","migrations"],
      "properties": {
        "clientServerPairTested":{"type":"boolean"},
        "requiredServerCapabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "systems":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["systemId","systemVersion"],"properties":{"systemId":{"type":"string"},"systemVersion":{"type":"string"},"ruleVariant":{"type":"object"}}}},
        "migrations":{"type":"array","items":{"type":"string"}}
      }
    },
    "artifacts": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","platform","path","bytes","sha256"],"properties":{"kind":{"enum":["desktop","server","content","docs"]},"platform":{"type":"string"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/sha256"},"url":{"type":"string","pattern":"^https://"},"signature":{"type":"string"}}}}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "allOf":[{"if":{"properties":{"status":{"const":"published"}}},"then":{"required":["sourceRevision","sourceSnapshotSha256","lockfileSha256"],"properties":{"artifacts":{"minItems":1},"compatibility":{"properties":{"clientServerPairTested":{"const":true}}}}}}]
}
