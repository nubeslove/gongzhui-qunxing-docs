{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerWorldSummary",
  "description": "当前显式构造的 WorldSummary；邀请码只从授权分享设置取得。",
  "type": "object",
  "properties": {
    "worldMode": {
      "anyOf": [
        {
          "const": "open",
          "type": "string"
        },
        {
          "const": "campaign",
          "type": "string"
        },
        {
          "const": "arena",
          "type": "string"
        }
      ]
    },
    "visibility": {
      "anyOf": [
        {
          "const": "public",
          "type": "string"
        },
        {
          "const": "invite",
          "type": "string"
        }
      ]
    },
    "spiral": {
      "$ref": "./contracts.schema.json#/$defs/SpiralSettings"
    },
    "ruleVariant": {
      "anyOf": [
        {
          "$ref": "./contracts.schema.json#/$defs/Object_29"
        },
        {
          "$ref": "./contracts.schema.json#/$defs/Object_30"
        }
      ],
      "description": "Theme variants remain distinct even when they share a base rules engine."
    },
    "systemId": {
      "anyOf": [
        {
          "const": "aaf",
          "type": "string"
        },
        {
          "const": "dnd5e-2024",
          "type": "string"
        },
        {
          "const": "lancer",
          "type": "string"
        },
        {
          "const": "otherworld-journey",
          "type": "string"
        }
      ],
      "description": "Absent only in legacy AAF worlds."
    },
    "systemVersion": {
      "type": "string"
    },
    "worldId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "gmNickname": {
      "type": "string"
    },
    "gmPlayerId": {
      "type": "string"
    },
    "assetVersion": {
      "type": "number",
      "description": "规则数据包版本（资源同步用，见 M6）"
    },
    "playerCount": {
      "type": "number"
    },
    "createdAt": {
      "type": "number"
    }
  },
  "required": [
    "worldId",
    "name",
    "gmNickname",
    "gmPlayerId",
    "assetVersion",
    "playerCount",
    "createdAt"
  ],
  "additionalProperties": false
}
